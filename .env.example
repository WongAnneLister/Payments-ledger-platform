# 本地开发环境变量示例
#
# 用法：cp .env.example .env  然后按需修改
#
# !! .env 已被 .gitignore 排除，绝不提交到版本库（PRD §17.3）。
# !! 本文件只放本地开发用的占位值，不放任何真实密钥。

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments_ledger

# 容器超级用户：仅用于本地容器初始化
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=postgres

# 应用运行角色：账本表将只有 INSERT 权限（见 docs/runbook/database-roles.md）
DB_APP_USER=payments_app
DB_APP_PASSWORD=payments_app_pw

# 迁移角色：持有 DDL 权限，只被 Flyway 使用
DB_MIGRATION_USER=payments_migrator
DB_MIGRATION_PASSWORD=payments_migrator_pw

DB_POOL_MAX=10
DB_POOL_MIN=2

# ---------- Redis / Kafka（基础设施已就绪，客户端在 PR07 / PR09 接入）----------
REDIS_PORT=6379
KAFKA_PORT=9092

# ---------- 运行角色端口 ----------
API_PORT=8080
WORKER_PORT=8081

# ---------- 日志 ----------
LOG_LEVEL_APP=INFO
# 设为 ecs / logstash / gelf 可输出结构化 JSON 日志
# LOG_STRUCTURED_FORMAT=ecs

# ---------- Stripe（PR05 才接入；此处仅占位说明）----------
# 本期严格禁止 live 凭据：environment_config.livemode=true 会在启动时被拒绝。
# 真实测试密钥由开发者本地配置，不写入版本库、不进日志。
# STRIPE_API_KEY=sk_test_xxx_REPLACE_LOCALLY
# STRIPE_WEBHOOK_SECRET=whsec_xxx_REPLACE_LOCALLY
